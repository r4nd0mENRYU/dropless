# Copy to .env and adjust. Only DATABASE_URL is required.

# Postgres connection (the only dependency — no Redis).
DATABASE_URL=postgres://dropless:dropless@127.0.0.1:5432/dropless

# HTTP API bind address.
BIND_ADDR=0.0.0.0:8080

# Which parts to run: all | api | worker
DROPLESS_ROLE=all

# Dispatcher tuning.
WORKER_COUNT=4
WORKER_BATCH=32
LOCK_SECS=30
HTTP_TIMEOUT_SECS=10
MAX_ATTEMPTS=16
# Max Postgres pool connections (keep above workers + in-flight ingest).
MAX_CONNECTIONS=10
# Fallback poll cadence (ms); LISTEN/NOTIFY drives the low-latency path.
POLL_INTERVAL_MS=500
# Max seconds to drain in-flight deliveries on shutdown before exiting.
SHUTDOWN_TIMEOUT_SECS=25

# If set, GET /metrics requires `Authorization: Bearer <token>` (its counts are
# cross-tenant). Leave unset only when /metrics is firewalled.
# METRICS_TOKEN=change-me

# Operator token for the cross-tenant admin console at /admin (god-view over all
# tenants). Unset = the whole /admin surface is disabled (404).
# ADMIN_TOKEN=change-me

# Per-tenant ingest rate limit (requests/sec). 0 = disabled. Burst defaults to
# 2× the rps when left at 0. Per-process (a multi-node API needs a shared store).
RATE_LIMIT_RPS=0
RATE_LIMIT_BURST=0

# Logging.
RUST_LOG=info,sqlx=warn
